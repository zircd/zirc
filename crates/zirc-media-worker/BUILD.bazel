load("//bazel:rust.bzl", "zirc_rust_binary")

# Its container images are built in zirc's own repository, from Debian's ffmpeg, which the
# published tree doesn't fetch: zirc.dev's, and ghcr.io/zircd/zirc-media for a self-hosted
# server, where the worker runs imgproxy beside it (--imgproxy).
zirc_rust_binary(
    name = "zirc-media-worker",
    test_size = "small",
)
