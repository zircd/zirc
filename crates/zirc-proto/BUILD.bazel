load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//bazel:rust.bzl", "zirc_rust_library")

zirc_rust_library(
    name = "zirc-proto",
    surface = "server",
    # brand.bzl: its PRODUCT_NAME is NAME's copy for Bazel, which a test keeps the same.
    compile_data = ["//bazel:brand.bzl"],
    # The web client runs it.
    wasm = True,
)

# TypeScript types for the `zirc login` handshake, cards and more, generated from these, for
# a web app that shares them: it checks its copy against what this prints.
rust_binary(
    name = "typescript",
    srcs = ["bin/typescript.rs"],
    lint_config = "//bazel:lints",
    visibility = ["//visibility:public"],
    deps = [":zirc-proto"],
)

# Checks role definitions by the server's rules, as JSON on stdin and out, for zirc.dev's
# ready-made roles' test (web/src/lib/role-templates.test.ts).
rust_binary(
    name = "check_roles",
    srcs = ["bin/check_roles.rs"],
    lint_config = "//bazel:lints",
    visibility = ["//visibility:public"],
    deps = [
        ":zirc-proto",
        "@crates//:serde_json",
    ],
)
