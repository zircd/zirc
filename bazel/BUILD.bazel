load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_lint_config")
load("@rules_rust_wasm_bindgen//:defs.bzl", "rust_wasm_bindgen_toolchain")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":platforms.bzl", "PLATFORMS")

[
    config_setting(
        name = platform,
        constraint_values = [
            "@platforms//os:" + os,
            "@platforms//cpu:" + cpu,
        ],
        visibility = ["//visibility:public"],
    )
    for platform, (os, cpu) in PLATFORMS.items()
]

# zirc's crates' lints: Cargo.toml's [workspace.lints] (as bazel/lints.bzl says them for the
# apps, tools and services) and more: docs on everything public, unsafe code forbidden. rules_rust
# can't read Cargo's table, so this is its sanctioned copy: change them together.
rust_lint_config(
    name = "lints",
    clippy = {"pedantic": "warn"},
    rustc = {
        "missing_docs": "warn",
        "unsafe_code": "forbid",
    },
    visibility = ["//visibility:public"],
)

# Says what a Bus error hit in a test that starts Ergo (bus_error.c), on Linux, where they
# happened; rust.bzl links it into each. alwayslink: nothing calls it, it installs itself.
cc_library(
    name = "bus_error",
    srcs = select({
        "@platforms//os:linux": ["bus_error.c"],
        "//conditions:default": [],
    }),
    alwayslink = True,
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "bus_error_demo",
    srcs = ["bus_error_demo.c"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [":bus_error"],
)

sh_test(
    name = "bus_error_test",
    srcs = ["bus_error_test.sh"],
    args = ["$(rootpath :bus_error_demo)"],
    data = [":bus_error_demo"],
    target_compatible_with = ["@platforms//os:linux"],
)

# What runs a test inside zirc-sandbox (sandbox.bzl).
exports_files([
    "brand.bzl",
    "sandbox_test.sh",
])

# Patches to modules published.MODULE.bazel overrides.
exports_files(glob(["*.patch"]))

# The wasm-bindgen CLI for the machine running the build, wasm-bindgen's own release at the
# crate's version (MODULE.bazel), in place of rules_rust_wasm_bindgen's older one.
sh_binary(
    name = "wasm_bindgen_cli",
    srcs = select({
        ":" + platform: ["@wasm_bindgen_cli_{}//:wasm-bindgen".format(platform.replace("-", "_"))]
        for platform in PLATFORMS
    }),
)

rust_wasm_bindgen_toolchain(
    name = "wasm_bindgen_toolchain_impl",
    wasm_bindgen_cli = ":wasm_bindgen_cli",
)

toolchain(
    name = "wasm_bindgen_toolchain",
    toolchain = ":wasm_bindgen_toolchain_impl",
    toolchain_type = "@rules_rust_wasm_bindgen//:toolchain_type",
)
