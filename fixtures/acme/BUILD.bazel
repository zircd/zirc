load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Acme, the made-up team every app's screenshots, zirc.dev's home page and its docs show
# (README.md): showcase.json is the team and its morning.
exports_files(
    [
        "coupon-before-after.png",
        "showcase.json",
    ],
    visibility = [
        # The phones' tests and screenshot hosts have the real core show it, as the core's
        # own tests do.
        "//oss/apps/android:__subpackages__",
        "//oss/apps/mobile/core:__pkg__",
        "//oss/apps/ios:__subpackages__",
        # The Mac app's harness shows it, as its screenshots do.
        "//oss/apps/mac:__pkg__",
        # The web client's screenshots, zirc.dev's home page's among them, stage it too.
        "//oss/web:__pkg__",
        # The desktop's showcase, whose lines zirc-app's tests stage (src/showcase.rs).
        "//crates/zirc-app:__pkg__",
    ],
)

# The checker, which the home page's team (//fixtures/home) is checked by too.
exports_files(
    ["check.py"],
    visibility = ["//fixtures/home:__pkg__"],
)

# Everything showcase.json names is in it: who said what, whose agents, which conversations.
sh_test(
    name = "showcase_test",
    size = "small",
    srcs = ["check.sh"],
    args = ["$(rootpath showcase.json)"],
    data = glob(["*.png"]) + [
        "check.py",
        "showcase.json",
    ],
    tags = [
        "kind:unit",
        "surface:app-core",
    ],
)
